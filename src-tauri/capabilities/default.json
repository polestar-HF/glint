{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Popup and settings windows",
  "windows": ["popup", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/polestar-HF/glint" },
        { "url": "https://github.com/polestar-HF/glint/*" }
      ]
    }
  ]
}
