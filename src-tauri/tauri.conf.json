{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glint",
  "version": "0.2.4",
  "identifier": "app.glint.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/models/v6-small/*": "models/v6-small/",
      "resources/onnxruntime.dll": "onnxruntime.dll",
      "resources/vcrt/msvcp140.dll": "msvcp140.dll",
      "resources/vcrt/msvcp140_1.dll": "msvcp140_1.dll",
      "resources/vcrt/vcruntime140.dll": "vcruntime140.dll",
      "resources/vcrt/vcruntime140_1.dll": "vcruntime140_1.dll",
      "../third_party/qingicon/LICENSE": "licenses/qingicon-LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
